      "source_event_id": "https://api.weather.gov/alerts/urn:oid:2.49.0.1.840.0.f6c56adff45810747c6f90ae2eed1598b8c4a58b.001.1",
      "expires_at_utc": "2026-11-12T16:15:00-08:00",
      "last_updated_at_utc": "2026-11-13T10:00:00-08:00",
      "source_metadata": {
        "noaa_event": "Winter Storm Watch",
        "noaa_description": "* WHAT...Snow is expected for elevations above 6000 feet. Total snow\naccumulations up to a foot, with up to 2 feet at the highest peaks.\nMinor accumulations of around an 1 inch possible down to 5000 feet.\nWinds could gust as high as 60 mph.\n\n* WHERE...Northern Sierra above 6000 feet, including Highway 50,\nInterstate 80, State Route 4, State Route 108, Southern Cascades\nabove 6000 feet, including Lassen National Park.\n\n* WHEN...From Friday morning through Monday afternoon.\n\n* IMPACTS...Travel could be very difficult. The hazardous conditions\ncould impact the Friday evening and Monday morning commutes. Strong\nwinds could cause downed tree branches, localized power outages,\nnear whiteout conditions.\n\n* ADDITIONAL DETAILS...Snow levels 6500 to 7500 feet Friday, dropping\nto 5500 to 6500 feet Saturday morning. Levels increase Sunday\nmorning to 6500 to 7500 feet before lowering again to 5500 to 6500\nfeet Monday. Heaviest snowfall expected Friday night into Saturday\nmorning. Light flurries to an inch possible down to 5000 feet with\nhigher accumulations remaining above 6000 feet. Lull in activity\nSaturday afternoon and evening, followed by additional snow\nSaturday night through Monday.",
        "noaa_severity": "Severe",
        "noaa_urgency": "Future",
        "noaa_instruction": "Check the latest road conditions from Caltrans online at\nquickmap.dot.ca.gov or dial 5 1 1.",
        "noaa_sender": "NWS Sacramento CA"
      }
    },
